# Copy to .env and fill in. .env is git-ignored — never commit real values.
# All integrations are OPTIONAL; the dashboard works fully without them.

# --- Coinbase (read-only "View" API key strongly recommended) ---
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=
COINBASE_API_URL=https://api.exchange.coinbase.com

# --- Google Sheets (optional portfolio sync) ---
# Absolute path to a service-account JSON file kept OUTSIDE this repo.
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_WORKBOOK=

# --- Market data (optional; yfinance needs no key) ---
MARKET_DATA_PROVIDER=yfinance
