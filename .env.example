# Copy to .env and fill in. .env is git-ignored — never commit real values.
# All integrations are OPTIONAL; the dashboard works fully without them.

# --- Coinbase (read-only "View" API key strongly recommended) ---
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=
COINBASE_API_URL=https://api.exchange.coinbase.com

# --- Google Sheets (optional portfolio sync) ---
# Absolute path to a service-account JSON file kept OUTSIDE this repo.
GOOGLE_SHEETS_CREDENTIALS_PATH=
GOOGLE_SHEETS_WORKBOOK=

# --- Market data (optional; yfinance needs no key) ---
MARKET_DATA_PROVIDER=yfinance

# --- Optional hosted tailoring; UI consent is still required for each request ---
GEMINI_API_KEY=
OPENAI_API_KEY=
FINREC_LLM_API_KEY=
# FINREC_LLM_BASE_URL=https://your-approved-provider.example/v1
# FINREC_LLM_MODEL=your-approved-model

# --- Optional local storage relocation (private financial data) ---
# FINREC_HOME=/absolute/private/directory
# FINREC_DB=/absolute/private/directory/finrec.db

# --- API: absent token means loopback-only, trusted-local operation ---
# Configuring BOTH values enables one authenticated server-selected account.
# Use a strong secret, TLS, and an access-controlled deployment.
FINREC_API_TOKEN=
FINREC_API_USER=
FINREC_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
